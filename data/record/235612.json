/crt/l/07/19/64889_crt_48KJR.jpg?r=1536463914","actor_ids":[4758,76687,79187,79253],"name_cn":"酿脓链球菌","summary":"咽頭、消化器、皮膚などに生息する、ごくありふれた常在菌の一種だが多様な疾患の原因となることがある。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"酿脓链球菌","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":64890,"name":"緑膿菌","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/b4/1c/64890_crt_I4Gk9.jpg?r=1536463864","actor_ids":[24703,78948,79253],"name_cn":"绿脓菌","summary":"自然環境中に存在する代表的な常在菌の一種。\r\n緑膿菌感染症の原因となる。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"绿脓菌","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":64891,"name":"消化管細胞","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/d8/08/64891_crt_xGn3G.jpg","actor_ids":[6278,29807,76687,79253],"name_cn":"消化管细胞","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"消化管细胞","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":65087,"name":"好塩基球","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/20/78/65087_crt_NcdNb.jpg?r=1537843375","actor_ids":[4513,39778,76687,79258],"name_cn":"嗜碱性粒细胞","summary":"白血球の一種。全白血球の1％未満と言われている。\r\n好塩基球が特定の抗原に出会うとヒスタミンなどが放出され、アレルギー反応を引き起こすとされている。\r\n好中球と好酸球を問題部位に引き寄せる物質を作る。好塩基球にも免疫にかかかる機能があると考えられているが、まだ十分に解明されていない。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"嗜碱性粒细胞","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":65088,"name":"腸炎ビブリオ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/8a/bc/65088_crt_v4kG4.jpg?r=1536464727","actor_ids":[7600,79115,79232,79253],"name_cn":"肠炎弧菌","summary":"主に海水中に生息する細菌であり、この菌に汚染された魚介類を食べることにより、激しい腹痛などを伴う感染型の腸炎ビブリオ食中毒を発症させることがある。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"肠炎弧菌","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":65089,"name":"カンピロバクター","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/7d/c6/65089_crt_KeKqF.jpg?r=1536463968","actor_ids":[20365,78925,78955,79165],"name_cn":"弯曲杆菌","summary":"発熱、下痢、腹痛などをもたらす感染性腸炎の原因菌。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"弯曲杆菌","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":65263,"name":"スギ花粉","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/ed/11/65263_crt_6c3IK.jpg","actor_ids":[5007,79115,79253],"name_cn":"杉树花粉","summary":"スギ花粉が抗原（アレルゲン）となって起きる。”くしゃみ、鼻水、鼻づまり、目のかゆみ”などのアレルギー症状が起こる。ピークは2～3月。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"杉树花粉","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":65452,"name":"NK細胞","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/95/75/65452_crt_vaHmm.jpg?r=1537843063","actor_ids":[8808,39850,72263,78955],"name_cn":"NK细胞","summary":"全身をパトロールし、がん細胞やウイルス感染細胞などを見つけ次第攻撃する。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"NK细胞","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":65755,"name":"がん細胞","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/07/16/65755_crt_hZjeT.jpg","actor_ids":[3927,23020,78948,79257],"name_cn":"癌细胞","summary":"由于细胞的遗传基因发生异常，无限增殖的细胞。它能入侵周遭正常细胞的边界。不断增殖。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"癌细胞","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":66095,"name":"セレウス菌","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/63/41/66095_crt_X8XeU.jpg?r=1537841793","actor_ids":[4147,79187],"name_cn":"蜡样芽孢杆菌","summary":"土、水中など自然環境中に広く分布している土壌細菌の1つ。発育の段階で芽胞と呼ばれる熱に強い殻を作り、100℃30分の過熱にも耐えることができる。下痢型、嘔吐型の2種類の食中毒を引き起こすことがある。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"蜡样芽孢杆菌","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":66210,"name":"胸腺上皮細胞教官","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/26/ee/66210_crt_pwng2.jpg?r=1537843461","actor_ids":[4130,79253],"name_cn":"胸腺上皮细胞教官","summary":"胸腺学校の先生。\r\nリンパ球を哺育し、T細胞の分化を助ける細胞。胸腺を形成している。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"胸腺上皮细胞教官","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":66254,"name":"白血球（2001）","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/ec/1e/66254_crt_rpgzG.jpg","actor_ids":[20142,79177,79187],"name_cn":"白血球（2001）","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"白血球（2001）","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":66256,"name":"後輩赤血球","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/71/dd/66256_crt_30QIx.jpg?r=1537939547","actor_ids":[5727,39748,78955,79081,79254],"name_cn":"红细胞（NT4201）","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"红细胞（NT4201）","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":66307,"name":"好中球先生","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/0f/29/66307_crt_4Cj11.jpg?r=1537843861","actor_ids":[4256,79177],"name_cn":"","summary":"細菌が侵入した際の赤芽球の避難訓練のお手伝いにやってきた好中球。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[],"__dataclass__":"Character"},{"id":66335,"name":"単球","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/b0/0b/66335_crt_bRe1R.jpg?r=1537884633","actor_ids":[3945,78955],"name_cn":"单核细胞","summary":"全白血球の約7％を占める単核の遊走細胞。他の免疫細胞同様、生体防御に関与する。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"单核细胞","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":7824