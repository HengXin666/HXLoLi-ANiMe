eyValue"}],"__dataclass__":"Character"}],"relations":[{"id":305429,"name":"葬送のフリーレン","name_cn":"葬送的芙莉莲","relation":"书籍","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/a1/bd/305429_axzF3.jpg","__dataclass__":"Relation"},{"id":400602,"name":"葬送のフリーレン","name_cn":"葬送的芙莉莲","relation":"前传","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/13/c5/400602_ZI8Y9.jpg","__dataclass__":"Relation"},{"id":549563,"name":"葬送のフリーレン ～●●の魔法～2期","name_cn":"葬送的芙莉莲 ～●●的魔法～2期","relation":"衍生","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/a9/55/549563_wko8L.jpg","__dataclass__":"Relation"},{"id":615503,"name":"The Story of Us","name_cn":"","relation":"片尾曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/c8/f1/615503_LpZTt.jpg","__dataclass__":"Relation"},{"id":621059,"name":"lulu.","name_cn":"","relation":"片头曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/f9/94/621059_Ge0nc.jpg","__dataclass__":"Relation"},{"id":621637,"name":"TVアニメ『葬送のフリーレン』Season2 Original Soundtrack","name_cn":"","relation":"原声集","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/35/76/621637_45qQQ.jpg","__dataclass__":"Relation"},{"id":638133,"name":"葬送のフリーレン 第3期【黄金郷編】","name_cn":"葬送的芙莉莲 第三季 黄金乡篇","relation":"续集","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/bc/31/638133_zIb02.jpg","__dataclass__":"Relation"},{"id":657875,"name":"葬送のフリーレン フィルムコンサート2026","name_cn":"","relation":"三次元","type":6,"image_url":"https://lain.bgm.tv/pic/cover/l/8c/a9/657875_3oVla.jpg","__dataclass__":"Relation"},{"id":660333,"name":"葬送のフリーレン／ミュージック・コレクション","name_cn":"","relation":"书籍","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/9f/b4/660333_21tpZ.jpg","__dataclass__":"Relation"}],"episodes":[{"id":1575936,"name":"じゃあ行こうか","name_cn":"那我们走吧","air_date":"2026-01-16","desc":"魔法都市オイサーストを後にし、北側諸国の道を行くフリーレン、フェルン、シュタルク。その道中、緩んだ地盤から穴の中へ落ちてしまう。そこは魔法を無効化する力を持った鉱石“封魔鉱”が一面に広がっていた。フリーレンとフェルンが魔法を使うことができず、地上に続く道を探すが、そこに魔物が現れて…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・演出：北川朋哉\r\n作画監督：高瀬丸","duration_seconds":1440,"ep":1,"sort":29,"type":0,"__dataclass__":"Episode"},{"id":1575937,"name":"南の勇者","name_cn":"南方勇者","air_date":"2026-01-23","desc":"北側諸国の村で勇者の像を磨く依頼を受けたフリーレンたち。その像はヒンメルのものではなく、かつて人類最強と謳われた“南の勇者”の像だった。フリーレンは“南の勇者”と出会った時を思い出す…。その後訪れたダッハ伯爵領の城下町で、フリーレンたちは領主から「魔族から宝剣を取り戻してほしい」と頼まれて…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：北川朋哉\r\n演出：武藤信宏\r\n作画監督：小嶋慶祐、藤中友里","duration_seconds":1440,"ep":2,"sort":30,"type":0,"__dataclass__":"Episode"},{"id":1575938,"name":"好きな場所","name_cn":"喜欢的地方","air_date":"2026-01-30","desc":"温泉地のエトヴァスでフリーレンたちは温泉に思いを馳せるが、山村はすでに廃れていた。山奥に「エトヴァス山の秘湯」があるという話を聞いた3人はそこに向かうことに。険しく、魔物も棲む山道を進んでいった先に待つものは果たして…。そして次の都市に到着すると、フェルンはシュタルクから意外な誘いを受ける。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・演出：圡屋陽平\r\n作画監督：謝 鋒涛、原野瑠奈","duration_seconds":1440,"ep":3,"sort":31,"type":0,"__dataclass__":"Episode"},{"id":1575939,"name":"誰かの故郷","name_cn":"他人的故乡","air_date":"2026-02-06","desc":"フェルンをからかうつもりで誘ったシュタルクだったが、結果2人はデートをすることに。街のさまざまな場所を訪れる2人はやがて展望広場へ。そこでフェルンが口にしたのは…。後日、街を後にした3人は過酷な北部高原へと足を踏み入れる。ある村落に立ち寄ると、その近くに強力な魔物が出現すると聞き…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・作画監督：瀬口泉\r\n演出：堀健太郎\r\n魔物作画監督：原科大樹","duration_seconds":1440,"ep":4,"sort":32,"type":0,"__dataclass__":"Episode"},{"id":1575940,"name":"北部高原の物流","name_cn":"北部高原的物流","air_date":"2026-02-13","desc":"ある酒場町でフリーレンはドワーフのファスと再会する。彼は無類の酒好きで、200年以上も皇帝酒ボースハフトを探しており、自身が掘った坑道の先にその酒が眠っているという。果たして見つかるのか…。そして次に訪れるノルム商会領では、なんとフリーレンに80年前から多額の借金があることが判明し…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・演出・作画監督：小橋弘侑","duration_seconds":1440,"ep":5,"sort":33,"type":0,"__dataclass__":"Episode"},{"id":1575941,"name":"討伐要請","name_cn":"讨伐委托","air_date":"2026-02-27","desc":"北部高原のある村に、ゼーリエからの魔族討伐の要請を受けた一級魔法使い、ゲナウとメトーデの姿があった。その村はゲナウの故郷だという…。そしてそこに、同じく討伐要請を受けたフェルン、そしてフリーレンとシュタルクもやって来た。村はすでに全滅しており、犠牲者の特徴的な傷跡から、ある魔族の姿が見え隠れする。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・作画監督：原科大樹\r\n演出：武藤信宏\r\n総作画監督：小嶋慶祐","duration_seconds":1440,"ep":6,"sort":34,"type":0,"__dataclass__":"Episode"},{"id":1575942,"name":"神技のレヴォルテ","name_cn":"神技的雷沃戴","air_date":"2026-03-06","desc":"ゲナウの村を全滅させた魔族、それは四本の腕で剣を自在に振るう強敵“神技のレヴォルテ”とその手下たちだった。\r\nフリーレン、フェルン、メトーデの3人は魔族探索のため森へ、シュタルクとゲナウは村民の遺体をノルム騎士団が引き取るまで村に残ることに。そしてそれぞれに、残忍な魔族たちが近づく。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：原科大樹、斎藤圭一郎\r\n演出：山内愛弥\r\n総作画監督：小嶋慶祐\r\n作画監督：吉川真一\r\nアクション作画監督：原科大樹","duration_seconds":1440,"ep":7,"sort":35,"type":0,"__dataclass__":"Episode"},{"id":1575943,"name":"立派な最期","name_cn":"壮烈的牺牲","air_date":"2026-03-13","desc":"村に現れた“神技のレヴォルテ”に対するは、戦士シュタルクと、“黒金の翼を操る魔法＜ディガドナハト＞”を駆使するゲナウ。レヴォルテの強烈な攻撃に、2人は打ち勝つことができるのか…!? 一方、フリーレン、フェルン、メトーデも、強力な魔法を操る魔族ゾリーダとヘモンと対峙していた―――！\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・演出：藤本航己\r\n総作画監督：小嶋慶祐\r\n作画監督：長坂慶太\r\nアクション作画監督：岩澤亨","duration_seconds":1440,"ep":8,"sort":36,"type":0,"__dataclass__":"Episode"},{"id":1575944,"name":"ヒンメルの自伝","name_cn":"辛美尔的自传","air_date":"2026-03-20","desc":"竜の群れの脅威に苛まれるも故郷を捨てようとしない男の村。そして広大な湖・コリドーア湖の港町。旅の途中、さまざまな場所を訪れるフリーレンたち。コリドーア湖で渡し舟に乗ろうにも舟代が足らず、船頭から交換条件を持ち掛けられる。それは島の修道院に眠っている“ヒンメルの自伝”を見つけることだった。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ・演出：圡屋陽平\r\n作画監督：原野瑠奈","duration_seconds":1440,"ep":9,"sort":37,"type":0,"__dataclass__":"Episode"},{"id":1575945,"name":"美しい光景","name_cn":"美丽的光景","air_date":"2026-03-27","desc":"トーア大渓谷にかけられた、ドワーフ・ゲーエンが200年以上かけて作った巨大な橋。その橋には、ヒンメルとゲーエンのかつての秘話が隠されていた…。その後シュマール雪原へとやって来たフリーレンたちは、路銀を稼ぐために魔物討伐の依頼を受ける。一方、ひとりの一級魔法使いがある場所を訪れて…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：北川朋哉\r\n演出：堀健太郎\r\n作画監督：佐藤綾花\r\n作画監督補佐：小嶋慶祐、藤中友里\r\n\r\n黄金郷編パート\r\n絵コンテ・演出：北川朋哉\r\n作画監督：高瀬丸\r\n原画：箕輪豊","duration_seconds":1440,"ep":10,"sort":38,"type":0,"__dataclass__":"Episode"}],"__dataclass__":"ANiMeData"},"user_status":{"watch_status":2,"watched_eps":10,"last_update":"2026-11-06T20:06:30+08:00","comment":null,"tags":["日常"],"__dataclass__":"UserStatus"},"__dataclass__":"ANiMeRecord"}