d":410493,"name":"ぼっち・ざ・ろっく! vol.3 特典CD","name_cn":"","relation":"插入歌","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/90/1e/410493_3nS67.jpg","__dataclass__":"Relation"},{"id":410494,"name":"ぼっち・ざ・ろっく! vol.4 特典CD","name_cn":"","relation":"插入歌","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/d3/fb/410494_deWKZ.jpg","__dataclass__":"Relation"},{"id":412601,"name":"ぼっち・ざ・ろっく! vol.6 特典CD","name_cn":"","relation":"插入歌","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/17/ed/412601_eKWe4.jpg","__dataclass__":"Relation"}],"episodes":[{"id":1128641,"name":"転がるぼっち","name_cn":"翻转孤独","air_date":"2022-10-08","desc":"極度の人見知りで陰キャな少女、後藤ひとり。バンド活動に憧れギターを始めるも友達が出来ず一人で練習する毎日。ある日“結束バンド”というバンドでドラムをやっている伊地知虹夏に声をかけられ１日だけサポートギターをすることに……\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：斎藤圭一郎\r\n演出：斎藤圭一郎\r\n作画監督：けろりら","duration_seconds":1420,"ep":1,"sort":1,"type":0,"__dataclass__":"Episode"},{"id":1128642,"name":"また明日","name_cn":"明天见","air_date":"2022-10-15","desc":"結束バンドの活動を始めることになる3人。ライブを行うにはノルマがあると分かり、お金を稼ぐためにひとりは泣く泣くライブハウスSTARRYのアルバイトを始めることになる。人との交流が苦手なひとりは明日に迫る初日に向け、とある策を講じる。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：斎藤圭一郎\r\n演出：藤原佳幸\r\n作画監督：助川裕彦","duration_seconds":1420,"ep":2,"sort":2,"type":0,"__dataclass__":"Episode"},{"id":1128643,"name":"馳せサンズ","name_cn":"火速增员","air_date":"2022-10-22","desc":"新メンバーを探していた虹夏のことを思い出したひとりは、ギターが弾けるという陽キャで人気者の喜多に声をかけようと思うものの……\r\n\r\n脚本：吉田恵里香\r\n絵コンテ・演出：山本ゆうすけ\r\n作画監督：中村颯","duration_seconds":1420,"ep":3,"sort":3,"type":0,"__dataclass__":"Episode"},{"id":1128644,"name":"ジャンピングガール(ズ)","name_cn":"跳跃的女孩（们）","air_date":"2022-10-29","desc":"喜多も再び結束バンドに加入しメンバーも揃い、バンドとして本格始動。そんな中、リョウがオリジナルソングの作曲をし、その作詞をひとりは任されることになる。ひとりは作詞を通してバンドらしさと自分らしさの違いに思い悩む。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：刈谷暢秀\r\n演出：刈谷暢秀\r\n作画監督：まりんぐ・そんぐ , けろりら","duration_seconds":1420,"ep":4,"sort":4,"type":0,"__dataclass__":"Episode"},{"id":1128645,"name":"飛べない魚","name_cn":"不会飞的鱼","air_date":"2022-11-05","desc":"オリジナルソングも出来上がり、いよいよライブだと意気込む４人。星歌に出演させて欲しいと頼んでみたものの、まずオーディションを受けろと突っぱねられてしまう。ひとりは最近の激動の日々を振り返りとある決心を固め、オーディションに参加するのだった……\r\n\r\n脚本：吉田恵里香\r\n絵コンテ・演出：川上雄介\r\n作画監督：高橋沙妃","duration_seconds":1420,"ep":5,"sort":5,"type":0,"__dataclass__":"Episode"},{"id":1128646,"name":"八景","name_cn":"八景","air_date":"2022-11-12","desc":"ライブの出演のためチケットノルマ５枚が結束バンド各々に課せられた。友達がいないひとりは家族だけではノルマに満たないことに気づき絶望する。宣伝のためにビラを配ろうとしていたところ、路地裏で酔っぱらっている廣井きくりに出会うのだった。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ・演出：藤原佳幸\r\n作画監督：けろりら、冨田真理","duration_seconds":1420,"ep":6,"sort":6,"type":0,"__dataclass__":"Episode"},{"id":1128647,"name":"君の家まで","name_cn":"到你的家里","air_date":"2022-11-19","desc":"季節はすっかり夏に。ライブで着るTシャツのデザインを考えるために、ひとりの家に集まることになった喜多と虹夏。家に誰かを呼ぶことが初めてのひとりは、無事に２人をもてなすことが出来るのか！？\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：アマタジャンチキ（石井俊匡）\r\n演出：篠原啓輔\r\n作画監督：けろりら、Park Se Young、石田一将、川妻智美","duration_seconds":1420,"ep":7,"sort":7,"type":0,"__dataclass__":"Episode"},{"id":1128648,"name":"ぼっち・ざ・ろっく","name_cn":"孤独摇滚","air_date":"2022-11-26","desc":"ライブ当日。台風の影響で呼んでいたはずの家族や友達から続々とキャンセルの連絡がきてしまう。直前になってもお客さんはまばら、重い雰囲気のなか結束バンドは４人としての初ライブを迎える。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：斎藤圭一郎\r\n演出：瀬尾健\r\n作画監督：けろりら、Franziska van Wulfen、TOMATO","duration_seconds":1420,"ep":8,"sort":8,"type":0,"__dataclass__":"Episode"},{"id":1128649,"name":"江ノ島エスカー","name_cn":"江之岛电扶梯","air_date":"2022-12-03","desc":"ライブも成功し充実した夏休みを過ごせると思っていたひとり。結束バンドのみんなと遊ぶために予定を空けている（入れる予定もないけれど）が誘われる気配がない。様子がおかしくなっていくひとりを見て、遊んでいないことに気づいた面々は江の島に遊びに出かけるのであった。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：平峯義大\r\n演出：平峯義大\r\n作画監督：伊藤弘樹","duration_seconds":1420,"ep":9,"sort":9,"type":0,"__dataclass__":"Episode"},{"id":1128650,"name":"アフターダーク","name_cn":"黑夜之后","air_date":"2022-12-10","desc":"文化祭の準備が始まり、ひとりは体育館ステージの出し物にバンドで出演しチヤホヤされたい欲求と、緊張で失敗する恐怖の狭間で揺れ動く……\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：川上雄介\r\n演出：川上雄介\r\n作画監督：けろりら , きーくん , 高橋沙妃 , まりんぐ・そんぐ","duration_seconds":1420,"ep":10,"sort":10,"type":0,"__dataclass__":"Episode"},{"id":1128651,"name":"十二進法の夕景","name_cn":"十二进位法的黄昏","air_date":"2022-12-17","desc":"文化祭初日、虹夏とリョウはひとりのクラスのメイド喫茶に遊びにきた。喜多とともに不在のひとりを探し、４人合流した後は文化祭を回る。そして２日目のライブに向けて準備を進めるのであった。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：山本ゆうすけ\r\n演出：山本ゆうすけ\r\n作画監督：助川裕彦","duration_seconds":1420,"ep":11,"sort":11,"type":0,"__dataclass__":"Episode"},{"id":1128652,"name":"君に朝が降る","name_cn":"晨光落在你身上","air_date":"2022-12-24","desc":"バンドを組み様々な人たちに出会い、ひとりでは今まで見えてこなかった景色がそこには広がっていた。スティックが１曲目へのカウントを刻み、結束バンド４人の文化祭ライブがいま始まる。\r\n\r\n脚本：吉田恵里香\r\n絵コンテ：斎藤圭一郎\r\n演出：斎藤圭一郎\r\n作画監督：けろりら","duration_seconds":1420,"ep":12,"sort":12,"type":0,"__dataclass__":"Episode"},{"id":1127110,"name":"ABEMA特別番組「BOCCHI STATION」","name_cn":"","air_date":"2022-09-14","desc":"TVアニメ「ぼっち・ざ・ろっく！」の最新情報をお届けする特別番組『BOCCHI STATION』がAbemaにて独占生放送されることが決定いたしました！\r\nぜひご覧ください！\r\n\r\n■番組概要\r\n【放送日時】 2022年9月14日（水）夜8時〜夜9時\r\n【出演者】 青山吉能、鈴代紗弓、水野朔、長谷川育美\r\n【MC】 森遥香\r\n\r\n【放送チャンネル】 ABEMAアニメチャンネル\r\n【番組URL】 [url]https://abema.tv/channels/abema-anime/slots/CHAyzRs11Jz3D9[/url]","duration_seconds":0,"ep":0,"sort":1,"type":1,"__dataclass__":"Episode"},{"id":1131526,"name":"放送直前特番「ぼっち・ざ・ろっく！＃宇宙＃日本＃下北沢」","name_cn":"","air_date":"2022-10-01","desc":"10月8日から放送がスタートするTVアニメ「ぼっち・ざ・ろっく！」ですが、10月1日に放送直前特番「ぼっち・ざ・ろっく！＃宇宙＃日本＃下北沢」が地上波で放送することが決定いたしました！\r\nメインキャスト4人が舞台となっている下北沢を散歩する番組です。\r\n\r\nまたABEMAでも放送同時配信いたしますので、ぜひご覧ください！\r\n\r\n【放送直前特番「ぼっち・ざ・ろっく！＃宇宙＃日本＃下北沢」】\r\n■放送情報\r\n◆TOKYO MX、BS11、群馬テレビ、とちぎテレビ\r\n10月1日(土)24時00分～\r\n◆MRT宮崎放送\r\n10月1日(土)25時28分～\r\n◆MBS\r\n10月1日(土)27時08分～\r\n◆RKB毎日放送\r\n10月6日(木)27時00分～\r\n\r\n■配信情報\r\n◆ABEMA\r\n10月1日(土)24時00分～　※地上波同時配信\r\n————————————————————\r\n以下の局で放送直前特番「ぼっち・ざ・ろっく！＃宇宙＃日本＃下北沢」の放送時間が変更となります。\r\n\r\n★ MRT宮崎放送\r\n●変更前：2022年10月1日（土）　25時28分～\r\n●変更後：2022年10月1日（土）　26時58分～\r\n\r\n★MBS\r\n●変更前：2022年10月1日（土）　27時08分～\r\n●変更後：2022年10月1日（土）　28時00分～\r\n\r\nご理解のほど、宜しくお願い致します。","duration_seconds":0,"ep":0,"sort":2,"type":1,"__dataclass__":"Episode"},{"id":1151584,"name":"ぼっち・ざ・とーく！-LIVE-","name_cn":"","air_date":"2022-12-07","desc":"緊急生配信決定！\r\n毎週土曜24時より放送中のTVアニメ「ぼっち・ざ・ろっく！」。\r\n本作のメインキャスト4人が生放送で語り合います。\r\nアニメ本編と合わせて、ぜひお楽しみください。\r\n\r\n◆出演\r\n後藤ひとり　青山吉能\r\n伊地知虹夏　鈴代紗弓\r\n山田リョウ　水野朔\r\n喜多郁代　　長谷川育美\r\n\r\n[url]https://www.youtube.com/watch?v=XbnomkQcQQE[/url]","duration_seconds":0,"ep":0,"sort":3,"type"