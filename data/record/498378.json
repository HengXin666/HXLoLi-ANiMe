tv/pic/crt/l/36/f7/195417_crt_cC2qw.jpg","actor_ids":[4726],"name_cn":"加斯科因","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"加斯科因","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":195418,"name":"クロエ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/82/9c/195418_crt_CxOaF.jpg","actor_ids":[32687],"name_cn":"克萝伊","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"克萝伊","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":196747,"name":"西国情報局対東課","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/8e/8c/196747_crt_9GN17.jpg","actor_ids":[],"name_cn":"西国情报局对东课","summary":"简称“WISE”，是一个根据潜入东国的间谍等情报人员传来的信息，在暗中削弱企图恶化与西国关系的个人及团体的组织，凭借最先进的电子技术和情报人员出色的任务执行能力，守护着两国的和平。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"西国情报局对东课","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":196770,"name":"国家保安局","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/7c/71/196770_crt_QanaC.jpg","actor_ids":[],"name_cn":"国家保安局","summary":"简称“SSS”，是以维持东国国内治安为目的的组织，其主要工作为搜捕间谍及监视市民等。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"国家保安局","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":226992,"name":"ナレーション","relation":"旁白","image_url":"https://lain.bgm.tv/pic/crt/l/64/ff/226992_crt_mDGMN.jpg","actor_ids":[5171],"name_cn":"旁白 (间谍过家家)","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"旁白 (间谍过家家)","__dataclass__":"KeyValue"}],"__dataclass__":"Character"}],"relations":[{"id":279379,"name":"SPY×FAMILY","name_cn":"间谍过家家","relation":"书籍","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/c6/ab/279379_Bjc7O.jpg","__dataclass__":"Relation"},{"id":411427,"name":"SPY×FAMILY Season 2","name_cn":"间谍过家家 第二季","relation":"前传","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/69/5b/411427_1Bw95.jpg","__dataclass__":"Relation"},{"id":411428,"name":"劇場版 SPY×FAMILY CODE: White","name_cn":"剧场版 间谍过家家 代号：白","relation":"衍生","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/ec/82/411428_xwKKP.jpg","__dataclass__":"Relation"},{"id":588535,"name":"Actor","name_cn":"","relation":"片尾曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/1c/fa/588535_P8HJt.jpg","__dataclass__":"Relation"},{"id":589730,"name":"灯を護る","name_cn":"守护灯火","relation":"片头曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/e5/a3/589730_5cHCt.jpg","__dataclass__":"Relation"},{"id":591551,"name":"TVアニメ『SPY×FAMILY』Season 3 オリジナル・サウンドトラック","name_cn":"","relation":"原声集","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/a3/f5/591551_2zzuu.jpg","__dataclass__":"Relation"},{"id":612842,"name":"Bus Stop","name_cn":"","relation":"插入歌","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/36/a9/612842_TRroI.jpg","__dataclass__":"Relation"},{"id":618397,"name":"TVアニメ『SPY×FAMILY』Season 3 オリジナル・サウンドトラック コンプリートver.","name_cn":"","relation":"原声集","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/46/c0/618397_Zz8tk.jpg","__dataclass__":"Relation"}],"episodes":[{"id":1559968,"name":"バーリント・パニック／情報屋と〈夜帷〉","name_cn":"伯林特大骚动／情报商与〈夜帷〉","air_date":"2025-10-04","desc":"バーリント・パニック\r\n休日に公園を訪れたフォージャー家。ご機嫌でアイスを頬張るアーニャだったが、ボンドの未来予知から工事現場で事件が起こることを読み取り大慌て。なんとかロイドたちを現場へ連れていくと、作業員が重機を操り暴走しはじめて……。\r\n\r\n情報屋と〈夜帷〉\r\nフィオナは〈WISE〉の任務を受け、印章偽造のプロを探すためにフランキーを頼ることに。約束したクラブで偽造屋と会った２人だったが、交渉は難航。そこへ保安局が現れて……。\r\n\r\n脚本：矢島綾、加藤穂乃伽\r\n分镜：片桐崇、古橋一浩\r\n演出：赤松康裕\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：齋藤千尋、下條祐未\r\n制作进行：菅野彩奈\r\n制作：WIT STUDIO\r\n\r\nOP动画\r\n分镜·演出：夏目真悟\r\n作画监督：嶋田和晃\r\n制作进行：セイ福士、真鍋創人\r\n制作协力：MADHOUSE","duration_seconds":1420,"ep":1,"sort":38,"type":0,"__dataclass__":"Episode"},{"id":1559969,"name":"〈雷〉を回避せよ／■■■■の記憶Ⅰ","name_cn":"迴避〈雷电〉吧／■■■■的记忆Ⅰ","air_date":"2025-10-11","desc":"〈雷トニト〉を回避せよ\r\nイーデン校にトニトおばさんことシュラーク先生が現れた。風紀に厳しいシュラークは、アーニャのクラスでも持ち物検査を実施することに。ハンカチを忘れて慌てるダミアンに、アーニャは2つ持っているからと救いの手を差し伸べるが……。\r\n\r\n■■■■の記憶Ⅰ\r\n〈雷トニト〉のショックで倒れたロイドは、夢の中で幼少期を思い出す。友達との兵隊ごっこでは〈参謀〉と呼ばれ、平穏な日々を送っていた■■■■だが、突如空爆が街を襲う。\r\n\r\n脚本：山崎莉乃\r\n分镜：倉田綾子\r\n演出：倉田綾子\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：吉野彰敏、高橋千尋\r\n制作进行：人見　純\r\n制作：CloverWorks\r\n\r\nED动画\r\n分镜·演出：宮島直樹\r\n色彩脚本·修图师：Song Ha\r\n作画监督：嶋田和晃\r\n制作进行：國田　悠\r\n制作：CloverWorks","duration_seconds":1420,"ep":2,"sort":39,"type":0,"__dataclass__":"Episode"},{"id":1559970,"name":"■■■■の記憶Ⅱ","name_cn":"■■■■的记忆Ⅱ","air_date":"2025-10-18","desc":"目を覚ますと、空爆によって街は荒れ果て戦場と化していた。そのまま家族と離れ離れになった■■■■は、青年になり軍に入隊。銃を手に戦場に立つ日々だったが、ある夜、オスタニア兵のフランキーと出会い……。\r\n\r\n脚本：山崎莉乃\r\n分镜：今井友紀子\r\n演出：今井友紀子\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：いずみひろよ、迫江沙羅、米澤彩織、園田尚也\r\n作画监督辅佐：村井夏織\r\n制作进行：鄭 秀寅\r\n制作：CloverWorks","duration_seconds":1420,"ep":3,"sort":40,"type":0,"__dataclass__":"Episode"},{"id":1559971,"name":"スキャンダルの裏側／インペリアル・スカラーへの道","name_cn":"绯闻的内幕／通往皇帝的学徒的道路","air_date":"2025-10-25","desc":"スキャンダルの裏側\r\n東西交流イベントのため西国ウェスタリスに訪問予定だったオペラ界の巨匠・ウェルマンに、不倫や差別発言等のスキャンダルが発覚。さらに劇場へ殺害予告が届き、〈WISEワイズ〉はシルヴィアの指示で対策を練ることに。\r\n\r\nインペリアル・スカラーへの道\r\nある日の放課後、ヘンダーソンに資料を運ぶ手伝いを頼まれたアーニャ。ヘンダーソンは“皇帝の学徒インペリアル・スカラー”に至るための心構えを語るが、アーニャには全く響いていない様子で……。\r\n\r\n脚本：山崎莉乃\r\n分镜：三室健太\r\n演出：三室健太\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：廣澤治嘉、三浦春樹、佐藤菜穂\r\n\r\n制作进行：成瀬佳那（ZEXCS）\r\n制作协力：ZEXCS","duration_seconds":1420,"ep":4,"sort":41,"type":0,"__dataclass__":"Episode"},{"id":1559972,"name":"ママ友作戦","name_cn":"妈妈朋友大作战","air_date":"2025-11-01","desc":"ヨルは買い物に訪れたデパートで、階段から落ちそうになった女性、メリンダを助けて仲良くなる。驚異的な身体能力を見たメリンダは、ヨルをバレーボールに誘う。その後のお茶会でママ友トークを繰り広げていると、メリンダがダミアンの母であることが判明して……。\r\n\r\n脚本：山崎莉乃\r\n分镜：長井龍雪\r\n演出：萬尾龍一\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：上田翔太郎、伊藤弘樹、水谷汐里\r\n作画监督辅佐：吉野彰敏\r\n制作进行：國田　悠\r\n制作：CloverWorks","duration_seconds":1420,"ep":5,"sort":42,"type":0,"__dataclass__":"Episode"},{"id":1559973,"name":"白い嫉妬／イーデン校バスジャック事件","name_cn":"白色嫉妒／伊甸学园巴士劫持事件","air_date":"2025-11-08","desc":"白い嫉妬\r\nバーリント総合病院の診療部部長・ジェラルドは、優秀で人望のあるロイドに立場を奪われたと嫉妬し、あの手この手で嫌がらせをしかけていた。それでも全く評判が落ちない事に腹を立てたジェラルドは、ロイドをスパイだと偽り保安局に通報するが……。\r\n\r\nイーデン校バスジャック事件\r\n社会科見学に行くことになったアーニャ。スクールバスで向かう道中、ダミアンへの「ナカヨシ作戦」に意気込むが、なぜか上手くいかない。そんな中、極左組織〈赤いサーカス〉にバスが乗っ取られてしまい……!?\r\n\r\n脚本：安藤えりか\r\n分镜：佐々木 忍\r\n演出：佐々木 忍\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：前田千景、園田尚也、高橋千尋、山口智、いずみひろよ、迫江沙羅\r\n作画监督辅佐：村井夏織\r\n制作进行：氏山幸史郎\r\n制作：CloverWorks","duration_seconds":1420,"ep":6,"sort":43,"type":0,"__dataclass__":"Episode"},{"id":1559974,"name":"赤いサーカス","name_cn":"赤红马戏团","air_date":"2025-11-15","desc":"バスジャックに巻き込まれたイーデン校の面々。周囲が怯える中、アーニャは犯人の心を読んでバスの行き先を突き止める。ベッキーの機転も手伝って、SOSのメッセージを車外に投げ捨てることに成功するが、怪しい動きがバレてアーニャの首に爆弾がつけられてしまい……!?\r\n\r\n脚本：安藤えりか\r\n分镜：原田孝宏\r\n演出：原田孝宏\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：本田舞波、寒川歩、瀧原美樹、UKI\r\n制作进行：野田大介\r\n制作：CloverWorks","duration_seconds":1420,"ep":7,"sort":44,"type":0,"__dataclass__":"Episode"},{"id":1559975,"name":"バスジャック犯を制圧せよ","name_cn":"制伏巴士劫匪吧","air_date":"2025-11-22","desc":"警察と保安局がバスを包囲し膠着状態が続く中、駆け付けたヘンダーソンが生徒たちに食糧を届けるためバスの中へ。状況を打開するため、アーニャは果敢にテロリストに立ち向かうが……。\r\n\r\n脚本：安藤えりか\r\n分镜：金森陽子\r\n演出：小山田桂子（むすび）\r\n　　　進藤陽平\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：猪口美緒\r\n　　　　　studio Arche\r\n　　　　　趙 雅羅\r\n　　　　　金 知泳\r\n　　　　　申 熙秀\r\n\r\n制作进行：人見 純、石丸敢太\r\n制作进行辅佐：寺牛千早樹\r\n制作：CloverWorks","duration_seconds":1420,"ep":8,"sort":45,"type":0,"__dataclass__":"Episode"},{"id":1559976,"name":"アーニャのじだい きちゃった","name_cn":"安妮亚的时代来了","air_date":"2025-11-29","desc":"事件解決に貢献したことで、〈星〉を授与されたアーニャたち。初めての〈星〉に喜ぶベッキーをよそに、アーニャは調子に乗っているようで……。\r\n\r\n脚本：安藤えりか\r\n分镜：今井友紀子\r\n演出：飛田剛\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：九ノ日、白鳥ななみ、伊澤珠美、清水裕輔\r\n作画监督辅佐：三浦龍、村井夏織\r\n制作进行：太田睦菜\r\n制作：CloverWorks","duration_seconds":1420,"ep":9,"sort":46,"type":0,"__dataclass__":"Episode"},{"id":1559977,"name":"オースティンの苦悩／フツーの飲み会／げつめんちゃくりく","name_cn":"奥斯汀的烦恼／普通的聚餐／登陆月球","air_date":"2025-12-06","desc":"オースティンの苦悩\r\nバスジャック事件以来、不眠症に悩んでいるというセシル寮の寮先生チューター・オースティンは、ヘンダーソンの紹介でロイドの診察を受けることに。話をする中で、ロイドはオースティンが嘘をついてるのではと訝しむ。どうやら原因は他にあるようで……。\r\n\r\nフツーの飲み会\r\n職場の同僚たちと飲みに行くことになったヨル。同僚にからかわれ、普通はただいまのチューくらいするものだと吹き込まれてしまう。酔って帰宅したヨルは、出迎えてくれたロイドを見てパニックになり……。\r\n\r\nげつめんちゃくりく\r\n東西宇宙開発競争のニュースに感化されロケットの話題で盛り上がるアーニャとユーイン。それを見たダミアンは……。\r\n\r\n脚本：加藤穂乃伽\r\n分镜：岩岡夢子\r\n演出：岩岡夢子\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：佐藤静香、王國年\r\n\r\n制作进行：篠原和\r\n制作协力：ZEXCS","duration_seconds":1420,"ep":10,"sort":47,"type":0,"__dataclass__":"Episode"},{"id":1559978,"name":"レベル3非常事態","name_cn":"等级3紧急状况","air_date":"2025-12-13","desc":"ヨルが不満を訴えている様子を、偶然家に来たユーリに聞かれてしまったロイド。どうにか場を収めようとするが、〈WISEワイズ〉から緊急召集を受け出かけることに。オペレーション〈梟ストリクス〉を含む〈WISE〉の情報を、内通者のウィーラーが外部に持ち出したことが判明したのだ。ロイドの不倫を疑うユーリは、ヨルと一緒に尾行するが……。\r\n\r\n脚本：加藤穂乃伽\r\n分镜：北井嘉樹\r\n演出：北井嘉樹\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：こまもとあいこ、いずみひろよ、山口智、前田千景、大村将司、関口亮輔、吉野彰敏、阿久澤友恵、林珠銀\r\n　　　　　studio Arche\r\n　　　　　趙雅羅、金知泳、申熙秀\r\n\r\n作画监督辅佐：三浦龍、村井夏織\r\n制作进行：人見純、寺牛千早樹\r\n制作：CloverWorks","duration_seconds":1420,"ep":11,"sort":48,"type":0,"__dataclass__":"Episode"},{"id":1559979,"name":"下水道の死闘","name_cn":"下水道的死斗","air_date":"2025-12-20","desc":"保安局の策略により、正体がバレたロイド。残った足跡から下水道に逃げたと推察したユーリは一人で後を追うが、ユーリに変装した〈黄昏たそがれ〉と遭遇してしまい、直接対決することに。ロイドは頑丈なユーリに苦戦を強いられて……!?\r\n\r\n脚本：加藤穂乃伽\r\n分镜：今井友紀子\r\n演出：今井友紀子\r\n演出辅佐：中谷亜沙美\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：髙田 晃、園田尚也、水谷汐里、猪口美緒、金 到瑛、大村将司、伊藤弘樹、安留雅弥、河合拓也、高橋千尋、上田翔太郎、八重樫洋平\r\n作画监督辅佐：吉野彰敏、関口亮輔\r\n制作进行：國田　悠\r\n制作：CloverWorks","duration_seconds":1420,"ep":12,"sort":49,"type":0,"__dataclass__":"Episode"},{"id":1573665,"name":"生き残れない世界","name_cn":"无法生存下来的世界","air_date":"2025-12-27","desc":"下水道でウィーラーと遭遇したフィオナ。咄嗟に銃を構えるが、瀕死のロイドを人質に取られ、やむを得ず銃を捨てることに。だが、挑発を受け、怒りのあまりリミッターが外れたフィオナはウィーラーに襲い掛かり……。\r\n\r\n脚本：加藤穂乃伽\r\n分镜：今井友紀子\r\n演出：中谷亜沙美\r\n特殊动画部分 分镜·演出：ユージン\r\n脚本协力：古橋一浩\r\n总作画监督：嶋田和晃\r\n作画监督：三浦 龍、清水祐輔、後藤依子、林珠銀、前田千景、本田舞波、迫江沙羅、清水祐実\r\n作画监督辅佐：野々下いおり、伊藤弘樹\r\n制作进行：野田大介\r\n制作：CloverWorks","duration_seconds":1420,"ep":13,"sort":50,"type":0,"__dataclass__":"Episode"}],"__dataclass__":"ANiMeData"},"user_status":{"watch_status":2,"watched_eps":5,"last_update":"2026-11-06T20:06:22+08:00","comment":null,"tags":["ロリがある","搞笑","日常"],"__dataclass__":"UserStatus"},"__dataclass__":"ANiMeRecord"}