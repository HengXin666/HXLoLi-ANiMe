"}],"__dataclass__":"Character"},{"id":89405,"name":"ゾフィア","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/65/87/89405_crt_sosbM.jpg?r=1658114932","actor_ids":[40544],"name_cn":"索菲亚","summary":"【战士】的候补。与贾碧相反，虽然外表冷酷，却经常进行一些脱线的发言。","birth_year":null,"birth_month":9,"birth_day":26,"tags":[{"key":"简体中文名","value":"索菲亚","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"},{"key":"生日","value":"9月26日","__dataclass__":"KeyValue"},{"key":"身高","value":"142cm","__dataclass__":"KeyValue"},{"key":"体重","value":"34kg","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":92521,"name":"ニコロ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/a4/d0/92521_crt_212pj.jpg","actor_ids":[4354],"name_cn":"尼柯洛","summary":"马莱派出的帕拉迪岛调查队队员，被俘虏后在帕岛担任厨师一职","birth_year":null,"birth_month":7,"birth_day":23,"tags":[{"key":"简体中文名","value":"尼柯洛","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"},{"key":"生日","value":"7月23日","__dataclass__":"KeyValue"},{"key":"身高","value":"187cm","__dataclass__":"KeyValue"},{"key":"体重","value":"74kg","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":92522,"name":"イェレナ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/0d/cc/92522_crt_bDaHf.jpg","actor_ids":[3924],"name_cn":"伊雷娜","summary":"","birth_year":null,"birth_month":1,"birth_day":21,"tags":[{"key":"简体中文名","value":"伊雷娜","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"},{"key":"生日","value":"1月21日","__dataclass__":"KeyValue"},{"key":"身高","value":"190cm","__dataclass__":"KeyValue"},{"key":"体重","value":"63kg","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":130935,"name":"調査兵団","relation":"客串","image_url":"https://lain.bgm.tv/pic/crt/l/5a/5e/130935_crt_smzTT.jpg","actor_ids":[],"name_cn":"调查兵团","summary":"在《进击的巨人》世界观设定中，以“自由之翼”为标志的调查兵团是人类的军团部门中的最强军事力量。\r\n拥有与其他兵团不可比拟的超强战斗力，常期在墙外进行巡逻调查捕杀巨人，\r\n但每次出巡都会造成惨重的伤亡，也为人类未来与探知付出了重要的贡献。\r\n抱着必死的决心挑战墙外巨人领域。死亡率最高，所以是一般新兵绝不愿意加入的兵团。\r\n人类阵营中的革命派。士兵精锐度远非其他兵团可比，因为长期在前线与巨人战斗，所以几乎人人都具有非凡的战斗能力。\r\n新兵第一次参加墙外远征的死亡几率是五成，能够撑过来的人将会逐渐成为生存几率高的优秀士兵。是艾伦梦想加入的兵团。\r\n兵团徽章是重叠起来的鸟儿翅膀，为蓝白双色，寓意人类拒绝承受家畜般地笼中屈辱，始终向往自由的愿望。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"调查兵团","__dataclass__":"KeyValue"},{"key":"引用来源","value":"https://zh.moegirl.org.cn/调查兵团","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":142286,"name":"レオンハート","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/76/31/142286_crt_u7E3r.jpg","actor_ids":[3981],"name_cn":"雷恩哈特","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"雷恩哈特","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":142287,"name":"カリナ・ブラウン","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/76/41/142287_crt_151u5.jpg","actor_ids":[4734],"name_cn":"","summary":"","birth_year":null,"birth_month":9,"birth_day":3,"tags":[{"key":"性别","value":"女","__dataclass__":"KeyValue"},{"key":"生日","value":"9月3日","__dataclass__":"KeyValue"},{"key":"身高","value":"170cm","__dataclass__":"KeyValue"},{"key":"体重","value":"60kg","__dataclass__":"KeyValue"}],"__dataclass__":"Character"}],"relations":[{"id":8491,"name":"進撃の巨人","name_cn":"进击的巨人","relation":"书籍","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/ae/45/8491_cwCVC.jpg","__dataclass__":"Relation"},{"id":263750,"name":"進撃の巨人 Season 3 Part.2","name_cn":"进击的巨人 第三季 Part.2","relation":"前传","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/c2/56/263750_56TBs.jpg","__dataclass__":"Relation"},{"id":321706,"name":"衝撃","name_cn":"","relation":"片尾曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/24/ac/321706_8lEm8.jpg","__dataclass__":"Relation"},{"id":322969,"name":"僕の戦争","name_cn":"","relation":"片头曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/16/1d/322969_3Yzf0.jpg","__dataclass__":"Relation"},{"id":326913,"name":"TVアニメ「進撃の巨人」TFS OST \"Ashes on The Fire\"","n