:"https://lain.bgm.tv/pic/cover/l/55/25/361988_K8cRr.jpg","__dataclass__":"Relation"},{"id":559837,"name":"BONE BORN BOMB","name_cn":"","relation":"片头曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/e0/b1/559837_pbcoP.jpg","__dataclass__":"Relation"},{"id":565440,"name":"硝子の線","name_cn":"","relation":"片尾曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/8a/3f/565440_4wA2h.jpg","__dataclass__":"Relation"},{"id":577875,"name":"アニメ「タコピーの原罪」オリジナル・サウンドトラック","name_cn":"","relation":"原声集","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/c3/86/577875_kH1Ip.jpg","__dataclass__":"Relation"},{"id":654672,"name":"タコピーの原罪 -ありがとう、また明日-","name_cn":"","relation":"总集篇","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/6a/1b/654672_9NZ43.jpg","__dataclass__":"Relation"}],"episodes":[{"id":1510914,"name":"2016年のきみへ","name_cn":"致2016年的你","air_date":"2025-06-28","desc":"ハッピーを広めるため地球に降り立ったタコピーは、人間の女の子しずかと出会う。\r\nピンチを救ってもらったタコピーは、不思議な力を持つハッピー道具で彼女のために奔走するのだが、しずかは笑顔すら見せない。\r\nどうやらその背景には学校のお友達とおうちの複雑な事情が関係しているようで……。\r\n\r\n\r\n\r\n脚本：飯野慎也\r\n分镜：飯野慎也\r\n演出：飯野慎也\r\n作画监督：長原圭太","duration_seconds":2267,"ep":1,"sort":1,"type":0,"__dataclass__":"Episode"},{"id":1510915,"name":"タコピーの救済","name_cn":"章鱼哔的拯救","air_date":"2025-07-05","desc":"体育倉庫での出来事をきっかけに、まりなからのいやがらせが止んだ。\r\n仲直りの第一歩かもと喜ぶタコピーだったが、その晩、飼い犬のチャッピーの散歩をしているところにまりなが現れる。\r\nそれは、しずかをどん底に陥れるためのまりなの計画の始まりだった。\r\n\r\n\r\n脚本：猫田幸\r\n分镜：もああん\r\n演出：もああん\r\n总作画监督：長原圭太\r\n作画监督：もああん","duration_seconds":1295,"ep":2,"sort":2,"type":0,"__dataclass__":"Episode"},{"id":1510916,"name":"タコピーの告解","name_cn":"章鱼哔的忏悔","air_date":"2025-07-12","desc":"しずかを助けようとして、大惨事を引き起こしてしまったタコピー。\r\nハッピーカメラも壊れ、焦るタコピーだったが、とびきりの笑顔で喜ぶしずかを見て、ひとまず状況を受け入れることに。\r\nそんな中、しずかを心配して様子を見に来た東が、地面に横たわるまりなに気づいてしまう……。\r\n\r\n\r\n脚本：飯野慎也\r\n分镜：率華\r\n演出：率華\r\n总作画监督：長原圭太\r\n作画监督：率華、新井博慧、飯田剛士","duration_seconds":1580,"ep":3,"sort":3,"type":0,"__dataclass__":"Episode"},{"id":1510917,"name":"東くんの救済","name_cn":"东君的救赎","air_date":"2025-07-19","desc":"森に埋めた思い出ボックスが見つかり、事件が明るみに出てしまった。\r\n犯人探しが始まり、しずかへの疑惑の目が強くなっていくなか、しずかからの期待に応えたい東は自分を追い込んでしまう。\r\nそんな東は、普段から優等生として過ごす反面、完全無欠な兄・潤也に対して強い劣等感を抱えていた。\r\n\r\n\r\n脚本：猫田幸\r\n分镜：大島塔也\r\n演出：大島塔也\r\n总作画监督：長原圭太\r\n作画监督：中村颯","duration_seconds":1415,"ep":4,"sort":4,"type":0,"__dataclass__":"Episode"},{"id":1510918,"name":"2022年のきみへ","name_cn":"致2022年的你","air_date":"2025-07-26","desc":"夏休みがやってきた！\r\n父親に引き取られたというチャッピーに会うため、東京に向かうタコピーとしずか。\r\nしかし、タコピーたちを待ち受けていたのは予想外の出来事だった。\r\nこの日の出来事をきっかけに、タコピーとしずかの関係は大きく変わり始める。\r\n\r\n\r\n脚本：猫田幸\r\n分镜：森大貴\r\n演出：森大貴\r\n总作画监督：長原圭太\r\n作画监督：卓子意","duration_seconds":1470,"ep":5,"sort":5,"type":0,"__dataclass__":"Episode"},{"id":1510919,"name":"2016年のきみたちへ","name_cn":"致2016年的你们","air_date":"2025-08-02","desc":"まりなとの記憶を思い出したタコピーは、まりなが悲しむ原因となったしずかが良い子なのか悪い子なのか、分らなくなってしまう。\r\nそして、しずかと向き合うため、“おはなし”することを決意するのだが……。\r\nしずかにただ笑ってほしいと願うタコピーは、最後に何を決断するのか――。","duration_seconds":1337,"ep":6,"sort":6,"type":0,"__dataclass__":"Episode"}],"__dataclass__":"ANiMeData"},"user_status":{"watch_status":2,"watched_eps":6,"last_update":"2026-11-06T18:06:23+08:00","comment":null,"tags":["致郁"],"__dataclass__":"UserStatus"},"__dataclass__":"ANiMeRecord"}