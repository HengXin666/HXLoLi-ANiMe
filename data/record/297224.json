","value":"10月4日","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":71218,"name":"ゴウヒン","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/ed/af/71218_crt_WV0lW.jpg","actor_ids":[3832],"name_cn":"刚兵","summary":"雄性熊猫。\r\n黑市中的心理医生，常在黑市里巡逻打击食肉成瘾者。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"刚兵","__dataclass__":"KeyValue"},{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":71219,"name":"市長","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/e6/e9/71219_crt_ZkFhB.jpg?r=1606094568","actor_ids":[4287],"name_cn":"市长","summary":"強い肉食獣の象徴であるライオンでありながら、草食肉食が平等のクリーンな社会を目指す理想主義的な市長。昨年は同じライオンが率いる暴力団『シシ組』の壊滅に尽力した。若い頃から市長を目指しており、大学入学前に牙を抜き、全身の脱色や黒目の肥大化、肩幅の縮小など400万円かけて親しみやすい外見に整形したほど、イメージ戦略に力を傾けている。手だけは奥さんに「あなたの手が好きだわ」と言われたのでそのままにしているらしい。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"市长","__dataclass__":"KeyValue"},{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":71220,"name":"オグマ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/20/6e/71220_crt_5FSpT.jpg","actor_ids":[3961],"name_cn":"奥古玛","summary":"雄性红鹿。\r\n号角财团社长，路易的养父。\r\n因不善言语表达，常透过赠送高档或昂贵的物品表达对路易的关心。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"奥古玛","__dataclass__":"KeyValue"},{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":90751,"name":"ピナ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/eb/2e/90751_crt_OjQaU.jpg","actor_ids":[5209],"name_cn":"比纳","summary":"雄性大角羊。\r\n切里顿学院高中部一年级→二年级。\r\n看似言谈轻浮，实则有过人一等的圆滑处事智慧，在入社时刻意以发表的暧昧言论引起大多数肉食部员不满，借此试探环境与部员底细。\r\n拥有超高的分析能力与说服话术，胆识过人，面对利兹还能使其无法招架，之后多次帮雷格西解围，也理解了雷格西的为人。\r\n桃花运极强，跟众多女性交往，但不擅长记名字而屡次在调情的过程中被其他女性抓包。\r\n角色名称取源于德国舞蹈家碧娜·鲍许。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"比纳","__dataclass__":"KeyValue"},{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":92248,"name":"イブキ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/c9/e6/92248_crt_r0HR8.jpg","actor_ids":[4985],"name_cn":"伊布奇","summary":"裏市の暴力団『シシ組』の組員。粗暴な組員が多い中では落ち着いた理性的な性格で、相手に気遣いを見せることもある。トレードマークは眼鏡。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"伊布奇","__dataclass__":"KeyValue"},{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":92249,"name":"フリー","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/b0/5a/92249_crt_yZZZN.jpg","actor_ids":[6787],"name_cn":"","summary":"シシ組の組員のインドライオンで、顔に引っかき傷がある。血の気が多く、抗争などの戦闘時には先陣切って乗り込んでいく凶暴な性格だが、おちゃらけた一面も持つ。実は身体に『猫邪羅死』と書かれた刺青を入れているらしい。イブキとは違い、新しい組長のことを認めることができずにいる。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":92250,"name":"ロクメ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/a2/81/92250_crt_P6p55.jpg","actor_ids":[5009],"name_cn":"","summary":"性別不明・年齢不詳の謎に包まれたガラガラヘビ。チェリートン学園の警備員を務めている。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"性别","value":"？","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":92251,"name":"リズ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/6b/2a/92251_crt_cPrBe.jpg","actor_ids":[4607],"name_cn":"","summary":"高等部２年のヒグマ。演劇部の美術チームに所属。いつもニコニコと穏やかな性格で、マスコット的な存在。ハチミツが大好物。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":107626,"name":"ハイエナ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/4d/d9/107626_crt_R7pfv.jpg","actor_ids":[4935],"name_cn":"","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"性别","value":"♂","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":166315,"name":"タオ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/03/18/166315_crt_eFSMm.j