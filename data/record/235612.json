8948,79232],"name_cn":"树突细胞","summary":"体内に侵入してきた細菌や、ウイルス感染細胞などの断片を抗原として提示し、他の免疫系の細胞に伝える役割を持つ。その名の通り周囲に突起を伸ばしている。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"树突细胞","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":63054,"name":"好酸球","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/6f/e9/63054_crt_NdVty.jpg?r=1537843274","actor_ids":[10887,44012,78955,79081,79165],"name_cn":"嗜酸性粒细胞","summary":"アレルギーや寄生虫感染があるとき増殖する。弱いながらも他の白血球のように貪食能力がある。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"嗜酸性粒细胞","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":64218,"name":"肺炎球菌","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/a8/34/64218_crt_Gu20A.jpg?r=1531631269","actor_ids":[3955,24754,78948,79187,79253,79258],"name_cn":"肺炎球菌","summary":"肺炎などを引き起こす呼吸器病原性菌。\r\n莢膜(きょうまく)を持つ毒性の強い菌。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"肺炎球菌","__dataclass__":"KeyValue"},{"key":"引用来源","value":"http://hataraku-saibou.com/character/?chara=s_pneumoniae","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":64601,"name":"先輩赤血球","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/cc/1d/64601_crt_kbFEo.jpg?r=1536463744","actor_ids":[4893,39749,58217,72263,79165],"name_cn":"红血球前辈","summary":"赤血球(AE3808)の先輩。面倒見がよい。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"红血球前辈","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":64602,"name":"記憶細胞","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/c6/68/64602_crt_x6iBh.jpg?r=1537843430","actor_ids":[4724,79115,79232,79253],"name_cn":"记忆细胞","summary":"抗原の免疫を記憶しているリンパ球。同じ細菌やウイルスの再度の侵入に備えている。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名