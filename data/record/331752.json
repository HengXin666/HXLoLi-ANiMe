n.bgm.tv/pic/cover/l/e1/eb/464325_3OTwk.jpg","__dataclass__":"Relation"},{"id":497138,"name":"TVアニメ「進撃の巨人」 The Final Season Original Sound Track Complete Album","name_cn":"","relation":"原声集","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/6e/76/497138_haKK3.jpg","__dataclass__":"Relation"}],"episodes":[{"id":1018455,"name":"断罪","name_cn":"断罪","air_date":"2022-01-09","desc":"降りしきる雨の中、一人の兵士が倒れている。その横で謎の巨人の蒸気の中から、あの男が這い出てきて……。その頃、始まりの地・シガンシナ区でマーレが奇襲を仕掛け、巨人たちも動き出す。そして、始祖の巨人と鎧の巨人が再び対峙する。「来いよ、ライナー」。\r\n脚本：瀬古浩司 / 絵コンテ：片山一良 / 演出：林祐一郎\r\n総作画監督：秋田学 / 作画監督：杉本ミッシェル、藤田正幸\r\n\r\nOP絵コンテ/演出/原画:小島崇史","duration_seconds":1435,"ep":1,"sort":76,"type":0,"__dataclass__":"Episode"},{"id":1074744,"name":"騙し討ち","name_cn":"暗算","air_date":"2022-01-16","desc":"ミカサの「助けたい」と思う気持ちは本物なのか。エレンは何のために戦っているのか……。地を響かせ激突する巨人たち。マーレの奇襲に人々は武器を手に戦場へと向かう。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：林祐一郎、工藤晃子 / 演出：宍戸淳\r\n作画監督：朴旲烈、崔ふみひで / 総作画監督：山口仁七、秋田学","duration_seconds":1435,"ep":2,"sort":77,"type":0,"__dataclass__":"Episode"},{"id":1074745,"name":"兄と弟","name_cn":"兄与弟","air_date":"2022-01-23","desc":"獣の巨人と始祖の巨人、事態の鍵を握る2体の巨人を目指し、人々は争いを広げる。互いの思いと記憶が交錯し、兄弟の目指す先にあるものとは。\r\n脚本：瀬古浩司 / 絵コンテ：林祐一郎、大峰輝之、小松寛子 / 演出：大峰輝之\r\n総作画監督：新沼大祐、山口仁七 / 作画監督：小松寛子、皆川愛香利、岩瀧智","duration_seconds":1435,"ep":3,"sort":78,"type":0,"__dataclass__":"Episode"},{"id":1074746,"name":"未来の記憶","name_cn":"未来的记忆","air_date":"2022-01-30","desc":"弟は兄を拒み、兄は弟を見捨てなかった。救いたい思いだけ。たどり着いた果ての場所でエレンとジークはあの日の記憶とともに、父・グリシャの真実を知る。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：林祐一郎 / 演出：青島昂希\r\n総作画監督：北尾勝 / 作画監督：皆川愛香利、松岡秀明、王維慶","duration_seconds":1435,"ep":4,"sort":79,"type":0,"__dataclass__":"Episode"},{"id":1074747,"name":"二千年前の君から","name_cn":"2000年前的你留下的...","air_date":"2022-02-06","desc":"二千年前から抗い、戦い、進み続けてきたものたちの物語。それは、一体誰が始めた物語だったのか。歩き続ける始祖ユミルにエレンは語りかける「待っていたんだろ。ずっと…。二千年前から。誰かを。」\r\n脚本：瀬古浩司 / 絵コンテ：片山一良 、林祐一郎/ 演出：松浦直紀\r\n総作画監督：秋田学、山口仁七 / 作画監督：朴旲烈","duration_seconds":1435,"ep":5,"sort":80,"type":0,"__dataclass__":"Episode"},{"id":1074748,"name":"氷解","name_cn":"融解","air_date":"2022-02-13","desc":"ごうごうと鳴り響く大地。空まで立ち上る土煙。その先を進む、巨人の群れ。島の壁は今、なくなった。この世からそこにある命を駆逐するまで、誰もエレンを止めることはできない。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：宍戸淳 / 演出：宍戸淳、原英和、五十嵐季旺\r\n総作画監督：新沼大祐 / 作画監督：杉本ミッシェル、松岡秀明、朴旲烈","duration_seconds":1435,"ep":6,"sort":81,"type":0,"__dataclass__":"Episode"},{"id":1074749,"name":"夕焼け","name_cn":"晚霞","air_date":"2022-02-20","desc":"人々の混乱の中、かつては友であり、そして敵だった人物が目を覚ます。止まっていた時は進み、すべては変わった。そうなった時、選ぶのは……。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：山﨑みつえ / 演出：山﨑みつえ\r\n総作画監督：秋田学、山口仁七 / 作画監督：桑原幹根、崔ふみひで、松岡秀明、藤田正幸、山中いづみ","duration_seconds":1430,"ep":7,"sort":82,"type":0,"__dataclass__":"Episode"},{"id":1074750,"name":"矜持","name_cn":"尊严","air_date":"2022-02-27","desc":"進軍する巨人の軍勢。やがて、何も知らぬ人々を踏みつぶす。それを見上げる兵士と戦士たちは立ち尽くすのか、それとも立ち上がるのか。森の中にいた2人の兵士の気持ちはすでに固まっていた。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：岩瀧智 / 演出：三宅和男\r\n作画監督：桑原幹根、小松寛子 / 総作画監督：崔ふみひで","duration_seconds":1435,"ep":8,"sort":83,"type":0,"__dataclass__":"Episode"},{"id":1074751,"name":"終末の夜","name_cn":"终末之夜","air_date":"2022-03-06","desc":"戦火の先に、僕らの敵がいた。僕らは互いを憎み、蔑み、殺してきた。今、焚火の先にいるのは、異なる「正義」を持っている者たちだった。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：浜崎博嗣 / 演出：山﨑みつえ\r\n総作画監督：秋田学、北尾勝 / 作画監督：齊田博之、皆川愛香利、松岡秀明","duration_seconds":1435,"ep":9,"sort":84,"type":0,"__dataclass__":"Episode"},{"id":1074752,"name":"裏切り者","name_cn":"叛徒","air_date":"2022-03-13","desc":"世界を救うため、エレンを止める。そう決めた者たちの前に、かつての仲間が立ちふさがる。誰も死なせたくないという思いを胸に彼らは戦う。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：片山一良 / 演出：大峰輝之\r\n総作画監督：新沼大祐、山口仁七 / 作画監督：王維慶、朴旲烈、岩瀧智、静佳見","duration_seconds":1435,"ep":10,"sort":85,"type":0,"__dataclass__":"Episode"},{"id":1074753,"name":"懐古","name_cn":"怀旧","air_date":"2022-03-20","desc":"躊躇えば死ぬ。銃口を向け、引き金を引く。この裏切りの先に、世界を救う道があると信じて。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：寺岡厳 / 演出：宍戸淳\r\n総作画監督：崔ふみひで / 作画監督：杉本ミッシェル","duration_seconds":1435,"ep":11,"sort":86,"type":0,"__dataclass__":"Episode"},{"id":1074754,"name":"人類の夜明け","name_cn":"人类的黎明","air_date":"2022-04-03","desc":"あの日、見たこと。あの日、語り合ったこと。あの日、選んだこと。それは全て彼が望んだこと。彼は何も変わってない。\r\n\r\n脚本：瀬古浩司 / 絵コンテ：原英和、赤根和樹、林祐一郎 / 演出：原英和\r\n総作画監督：新沼大祐、秋田学、山口仁七 / 作画監督：桑原幹根、小松寛子、王維慶、朴旲烈","duration_seconds":1435,"ep":12,"sort":87,"type":0,"__d