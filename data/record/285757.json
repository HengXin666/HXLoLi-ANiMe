"__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":192365,"name":"レプテラ","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/e5/6c/192365_crt_lGJ0i.jpg","actor_ids":[20631],"name_cn":"","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[],"__dataclass__":"Character"},{"id":192366,"name":"ラプトラ","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/37/e3/192366_crt_Zi8ld.jpg","actor_ids":[],"name_cn":"","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[],"__dataclass__":"Character"},{"id":194466,"name":"剣鬼ブッタギリー","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/30/39/194466_crt_wYh3z.jpg","actor_ids":[66906],"name_cn":"剑鬼噼剁切利","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"剑鬼噼剁切利","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":196411,"name":"ブレイブジャイアント","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/15/c0/196411_crt_FsrYR.jpg","actor_ids":[],"name_cn":"","summary":"村田版で使用。\r\n腕時計型デバイスで召喚する最終兵器で、デフォルメチックな巨大ロボ。\r\nホーミングミサイル、頭部からのガトリング砲などの基本兵器のほか多彩な武装を持つが、稼働時間は3分しか持たない欠点がある。動力は縮退乾電池。\r\n渡り合いこそしたが、様々な形態を駆使する竜レベルに達した転生フェニックス男を倒すまでには至らなかった。\r\n\r\n単行本化前の原稿バージョンでは、転生フェニックス男と渡り合う様々な武装や必殺技があった。\r\nしかし「竜を倒しかける武器」が強すぎたためか、単行本になる際に展開が大きく変更されて武装はいくつか削除された*1。\r\nまた変更前はMSの操縦席のような操縦式だったが、改訂版ではガンバスターのようなダイレクトモーションを採用。\r\nこれは後述の『着る』という設定のため。ちなみにガンバスターをリスペクトしてか、操縦時は自動的に体操服になる。\r\n\r\n彼はこれをとても気に入っている上に「奥の手」というこだわりも持っており、転生フェニックス男戦時に使用する際には\r\n「僕が弱い上に幹部じゃないお前が想定以上に強かったから、ここで最終兵器を使うことになった」とプライドからの悔し泣きをしていた。\r\n原作でもこれ(あるいはそれに類するもの)を奥の手として用意している様で、ボフォイより「こっそり作っている大きなお人形」と揶揄されている。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"引用来源","value":[{"k":"アニヲタWiki(仮)","v":"https://w.atwiki.jp/aniwotawiki/pages/47277.html#id_e796b69a"}],"__dataclass__":"KeyValue"}],"__dataclass__":"Character"}],"relations":[{"id":55911,"name":"ワンパンマン","name_cn":"一拳超人","relation":"书籍","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/6f/a2/55911_n7jf7.jpg","__dataclass__":"Relation"},{"id":193619,"name":"ワンパンマン 第2期","name_cn":"一拳超人 第二季","relation":"前传","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/63/0f/193619_MLNLZ.jpg","__dataclass__":"Relation"},{"id":581020,"name":"Get No Satisfied !","name_cn":"","relation":"片头曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/36/bf/581020_z6o2T.jpg","__dataclass__":"Relation"},{"id":581021,"name":"そこに有る灯り","name_cn":"","relation":"片尾曲","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/24/c7/581021_7YebY.jpg","__dataclass__":"Relation"},{"id":618527,"name":"ワンパンマン 第3期 第2クール","name_cn":"一拳超人 第三季 第2部分","relation":"续集","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/a3/8b/618527_zZ6hN.jpg","__dataclass__":"Relation"}],"episodes":[{"id":1561273,"name":"作戦の会議","name_cn":"作战的会议","air_date":"2025-10-12","desc":"ヒーロー狩り・ガロウの強襲と怪人協会の急襲を退けたものの、強力な支援者の息子を連れ去られたヒーロー協会。タツマキらS級ヒーローが集合し救出作戦が進められるが、息子救出を急ぐナリンキは自前の傭兵部隊を結成させる。フブキはサイタマの元を訪れ作戦会議を提案するが、興味のないサイタマは買い物ついでにガロウを倒すと出かけてしまうのだった。その頃、怪人協会のアジトでは捕らえられていたガロウが目を覚ます。\r\n\r\n脚本：鈴木智尋 \r\n絵コンテ：永居慎平 \r\n演出：石田美由紀 \r\n総作画監督：小野和美 \r\n作画監督：小野和美、都築裕佳子","duration_seconds":1430,"ep":1,"sort":25,"type":0,"__dataclass__":"Episode"},{"id":1561274,"name":"怪人の条件","name_cn":"怪人的条件","air_date":"2025-10-19","desc":"怪人協会幹部への勧誘を受け、ヒーローの首を獲るためにアジトを出たガロウ。怪人に屈しはじめた市民の姿に憤りを感じながらも、腹ごしらえのためにファミレスを訪れ大量の食事を摂る。そこには食後のサイタマが偶然居合わせていた。財布を忘れピンチだったサイタマは食い逃げしたガロウを追いかける。逃走中のガロウはタレオと再会、だがそこにサイタマが現れ…。一方、キリサキングと蟲神はガロウを尾行し続けていた。\r\n\r\n脚本：鈴木智尋 \r\n絵コンテ：永居慎平\r\n演出：田中瑛\r\n総作画監督：小野和美\r\n作画監督：小野和美、小松香苗、洪範錫、中山由美","duration_seconds":1430,"ep":2,"sort":26,"type":0,"__dataclass__":"Episode"},{"id":1561275,"name":"生物の限界","name_cn":"生物的极限","air_date":"2025-10-26","desc":"ゾンビマンが追跡したどり着いたのは彼を生み出した天才科学者ジーナス博士の家だった。ジーナスは、ゾンビマンにリミッターの外れた強さについて説くのだが…。一方、ジェノスの救難信号を受けていたクセーノ博士は高級肉を手土産にサイタマの元を訪れる。そんな中、キリサキングと蟲神を相手に攻勢に出るガロウだったが、不意に現れたヘドロクラゲにタレオを人質に取られてしまう。そのころ怪人協会では災害レベル竜の幹部たちが集結していた…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：永居慎平\r\n絵コンテ協力：廣濑光希、岩永巌、川島優子（ラシクラボ/Rashiku）\r\n演出：雄谷将仁（トマソン/Tomason）、宮崎修治\r\n総作画監督：小野和美\r\n作画監督：但伊杨、王瑞浩、王家梁、杜明芮（鹿角映画）杨国庆、陈瑜、李茹雪（Orange Studio）葛欢、葛玉东（画形动画）岸影动画、Anime Infinite\r\n作画监督辅：小澤和则\r\n制作协力：TripleA","duration_seconds":1430,"ep":3,"sort":27,"type":0,"__dataclass__":"Episode"},{"id":1561276,"name":"反撃の狼煙","name_cn":"反击的狼烟","air_date":"2025-11-02","desc":"ヒーロー協会では、童帝がZ市に怪人協会のアジトがあることを突き止め、突入準備を進めていたが、ガロウを取り逃がしたシルバーファングと新参のジェノスは作戦から除外される。そんな中二人は、サイタマの自宅で地獄のフブキ、キングらとともに和やかに鍋を囲んでいた。一方、瀕死から回復したガロウは怪人協会へ侵攻する。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：永居慎平\r\n絵コンテ協力：廣濑光希、岩永巌、川島優子（ラシクラボ/Rashiku）\r\n演出：藤原和々\r\n総作画監督：長谷川眞也\r\n作画監督：都築裕佳子、金正男（J.C.STAFF作画部）河村あかり、南翔太","duration_seconds":1430,"ep":4,"sort":28,"type":0,"__dataclass__":"Episode"},{"id":1561277,"name":"怪人の王","name_cn":"怪人的王","air_date":"2025-11-09","desc":"怪人協会に侵攻し、キリサキングからタレオを救い出したガロウに次々と怪人たちが襲い掛かる。タレオを先に逃し災害レベル：竜の育ち過ぎたポチの壮絶な攻撃を辛うじてしのぐが、地底奥深くへ突き落される。そこにいたのはギョロギョロ。超能力でガロウの動きを封じ、自身が怪人王オロチを生み出したことを明かし共闘を持ち掛けるのだが…。その頃、静かな日常を過ごしていたサイタマは地下からの騒音が気になっていた。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：永居慎平\r\n演出：則座誠 \r\n総作画監督：長谷川眞也\r\n作画監督：中山由美、清水空翔、Seo Chae-young、Kang Soo-jung、Bang Hyo-jin、TripleA、南翔太","duration_seconds":1430,"ep":5,"sort":29,"type":0,"__dataclass__":"Episode"},{"id":1561278,"name":"不揃いのヒーローたち","name_cn":"不协调的英雄们","air_date":"2025-11-16","desc":"怪人協会突入を前にＳ級ヒーローが集結し作戦会議を開く。議論がかみ合わない中、Ａ級1位アマイマスクが現れＳ級と激しく対立する。そんな殺気立つ会議の場にキングが登場し…。一方ヒーロー協会を訪れていたシルバーファングとボンブはキングと遭遇し突入時の合流を約束。パワーアップしたジェノス、地獄のフブキもそれぞれサイタマの自宅に集結。怪人協会との決戦が目前に迫る中、サイタマは一人で騒音の発生源をめざしていた。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：永居慎平\r\n演出：西村大樹\r\n総作画監督：小野和美\r\n作画監督：沈陶裔、董立则、罗睿、陈亮、郁慧云、王经国、周乐谣、林夏洲、张倩茹","duration_seconds":1430,"ep":6,"sort":30,"type":0,"__dataclass__":"Episode"},{"id":1561279,"name":"後の先","name_cn":"后发制人","air_date":"2025-11-23","desc":"Ｚ市へ到着したヒーロー達を待ち受けていたのは数多の怪人だった。全方向からの奇襲攻撃に対して、サポートとして参加したＡ級以下のヒーロー達が連携しながら奮闘し怪人を抑え込む。童帝が怪人協会の狙いを推し量り始める中、A級2位イアイアンが災害レベル：鬼のサイレスラー相手に苦戦を強いられ、敵のレベルが上がり始める。戦慄のタツマキやアトミック侍らS級ヒーローが戦いに加わる中、上空ではギョロギョロが戦況を偵察していた…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：Omar Vallejos、永居慎平\r\n演出：宮崎修治\r\n総作画監督：長谷川眞也\r\n作画監督：小松香苗、洪範錫、都築裕佳子、Seo Chae-young、中崎萌佳、TripleA、鹿角映画、Orangestudio、Kiwi animation studio、七彩動画、studio cat、岸影動画","duration_seconds":1430,"ep":7,"sort":31,"type":0,"__dataclass__":"Episode"},{"id":1561280,"name":"忍の卷","name_cn":"忍之卷","air_date":"2025-11-30","desc":"怪人協会のアジトを目指し、地下へと突入するS級ヒーローたち。ギョロギョロはヒーローの所在を把握し幹部の怪人を配置していた。閃光のフラッシュを待ち受けていたのは疾風のウインドと業火のフレイム。同じ「里」の出身ながら怪人化し、災害レベル：竜を誇る二人は、忍のプライドを捨てた二人がかりの殺人技で、閃光のフラッシュに襲い掛かる！その頃、童帝は怪人王オロチに破壊されたメタルナイトの残骸を発見する。\r\n\r\n脚本：鈴木智尋 \r\n絵コンテ：永居慎平 \r\n演出：永居慎平、田中哲郎、石田美由紀 \r\n総作画監督：長谷川眞也、小野和美 \r\n作画監督：小松香苗、青木健一郎、南翔太、WUXI HUAXIAN ANIMATION PRODUCTION、sun qiang、fan dong dong、liu qi qi、zhang qian ru、HYUN GRAK、TripleA \r\nエフェクト作画監督：小澤和則","duration_seconds":1430,"ep":8,"sort":32,"type":0,"__dataclass__":"Episode"},{"id":1561281,"name":"童の勇","name_cn":"童之勇","air_date":"2025-12-07","desc":"ワガンマを助け出した童帝の前に現れたのは、転生し災害レベル：竜となったフェニックス男。数々の発明メカを繰り出しても歯が立たず一方的に圧倒される。ワガンマを守り抜くため決死の覚悟を決めた童帝は最終兵器ブレイブジャイアントを起動させる。強力な攻撃を与えるたびにパワーもスピードも進化し続けるフェニックス男との壮絶バトルの行方は…⁉　そして、その激しい衝撃は、地下深くを彷徨っていたサイタマにも届いていて…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：橋本敬史 \r\n演出：海宝興蔵\r\n総作画監督：長谷川眞也 \r\n作画監督：小野和美、都築裕佳子、中山由美、洪範錫、田中海人、下江一正、南翔太 メカ作画監督：橋本敬史 \r\nエフェクト作画監督：小澤和則","duration_seconds":1430,"ep":9,"sort":33,"type":0,"__dataclass__":"Episode"},{"id":1561282,"name":"不死身の泥仕合","name_cn":"不死身的泥沼战","air_date":"2025-12-14","desc":"どんな致命傷も回復するゾンビマンが対峙したのは異能の血を代々引き継ぐ吸血鬼バンパイア。不死のゾンビマンと血を吸えばどんな傷でも回復するバンパイアとの血で血を洗う泥仕合が幕を開ける！　一方、別の場所ではA級ヒーローのイアイアン、オカマイタチ、ブシドリルが怪人・弩Sに遭遇。ナリンキが突入させた私設傭兵部隊が弩Sに操られており3人は思わぬ苦戦を強いられる。その刹那、イケメン仮面アマイマスクが颯爽と現れて…。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：永居慎平\r\n演出：藤原和々、雄谷将仁 \r\n総作画監督：長谷川眞也\r\n作画監督：中崎萌佳、但伊楊、王瑞浩、楊宵、Orange Studio、鹿角映画、七彩動画、ANIME INFINITE LLC、岸影動画、図霊動漫制作有限公司 \r\nアクション作画監督：青木健一郎","duration_seconds":1430,"ep":10,"sort":34,"type":0,"__dataclass__":"Episode"},{"id":1561283,"name":"竜の幹部","name_cn":"龙级的干部","air_date":"2025-12-21","desc":"童帝は救出したワガンマを地上にいるセキンガルの元へと送り届け、最優先だった救出作戦は成功する。だが一方で、地下でタレオを見つけたアトミック侍は斬撃が通用しない黒い精子と、ゾンビマンは神通力を持ち桁違いのパワーを誇るホームレス帝と、ぷりぷりプリズナーは刑務所を襲撃した仇のニャーンと、それぞれ災害レベル：竜の幹部たちと激しい死闘を繰り広げていた。\r\n\r\n脚本：鈴木智尋\r\n絵コンテ：永居慎平 \r\n演出：石田美由紀\r\n総作画監督：長谷川眞也  \r\n作画監督：都築裕佳子、小松香苗、中山由美、洪範錫、河村あかり、南翔太\r\n作画監督補：小野和美  \r\nエフェクト作画監督：青木健一郎","duration_seconds":1430,"ep":11,"sort":35,"type":0,"__dataclass__":"Episode"},{"id":1561284,"name":"究極の生命体","name_cn":"究极的生命体","air_date":"2025-12-28","desc":"豚神が災害レベル竜：ハグキと激突し、超合金クロビカリが蟲神の猛攻を受ける中、サイタマは道中で見つけた犬（育ちすぎたポチ）を手懐けて案内をさせようと脳天にしつけの拳骨を叩きこむ。その衝撃波は地上にまで轟き、サイタマ家で待機していたジェノスが反応する。その頃、ギョロギョロの元に戦慄のタツマキがたどり着き、異次元の超能力バトルが始まろうとしていた。そして、サイタマの前には究極の生命体・怪人王オロチがついに姿を現す…！\r\n\r\n脚本：鈴木智尋 \r\n絵コンテ：永居慎平 \r\n演出：藤原和々、野上 良之 \r\n総作画監督：長谷川眞也、小野和美 \r\n作画監督：中山由美、都築裕佳子、小松香苗、小野和美、sun qiang、fan dong dong、liu qi qi、zhang qian ru、HYUN GRAK、田中 海人、青木 健一郎","duration_seconds":1430,"ep":12,"sort":36,"type":0,"__dataclass__":"Episode"},{"id":1575960,"name":"一撃でわかる！ONE PUNCH MAN 第２期マジ振り返り！","name_cn":"一击就懂！一拳超人 第2季认真回顾","air_date":"2025-10-05","desc":"","duration_seconds":1441,"ep":0,"sort":0,"type":1,"__dataclass__":"Episode"},{"id":1760143,"name":"サイタマとサイタマが壊したおもちゃ","name_cn":"","air_date":"2027-01-27","desc":"C市のスタジアムに現れた怪人・無限併殺鬼ムエンゴを一撃で倒したサイタマ。だがその衝撃で、逃げ遅れた少年マチオが大切にしていた古いアニメヒーロー・ニジマジンの人形まで壊してしまう。罪悪感からサイタマは瓦礫の中から粉々になった部品を探し始めるのだが…。一方、サイタマから相談を受けたジェノスは、生産終了となっていたニジマジンの人形を求めて手を尽くす。マチオのために展開する“師弟による大捜索”の行方は――。","duration_seconds":0,"ep":0,"sort":1,"type":1,"__dataclass__":"Episode"},{"id":1760144,"name":"フブキともてない男たち","name_cn":"","air_date":"2027-02-26","desc":"武装集団が廃ビルを占拠し、情報化社会へ反旗を翻すのかと思いきや、その真の要求は女性との真剣な出会いを求めるものだった！　男がビルに侵入すれば爆破するという条件の中、ヒーロー協会は爆破を回避するべく地獄のフブキ、三節棍のリリーらを一般人に変装させ、交渉要員として送り込む。要求通りやってきた女性たちに、武装集団は色めき立つが、ボスの目は欺けなかった。手下たちは一転して武器を手に一斉にフブキたちへ襲い掛かる…！","duration_seconds":0,"ep":0,"sort":2,"type":1,"__dataclass__":"Episode"},{"id":1760145,"name":"ゾンビマンとゾンビパニック","name_cn":"","air_date":"2027-03-26","desc":"深い山奥で墓を荒らす賞金首たち。お宝の王冠を手にした一味は直後、ゾンビと化していく――。現場で襲われた警備員から未知のウイルスが検出されたことを受け、ヒーロー協会は現場一帯を封鎖。紛糾する対策会議の場へと不意に現れたキングはゾンビマンの潜入作戦を提言する。上空からの降下作戦を図るも、失敗して地面に叩きつけられたゾンビマンが目にしたのは、ウイルスに感染した賞金首のゾンビたちだった…。","duration_seconds":0,"ep":0,"sort":3,"type":1,"__dataclass__":"Episode"}],"__dataclass__":"ANiMeData"},"user_status":{"watch_status":2,"watched_eps":5,"last_update":"2026-11-06T19:01:09+08:00","comment":null,"tags":["战斗"],"__dataclass__":"UserStatus"},"__dataclass__":"ANiMeRecord"}