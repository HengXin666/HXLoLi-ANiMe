://lain.bgm.tv/pic/crt/l/94/7c/125217_crt_9xJXP.jpg","actor_ids":[4110],"name_cn":"末世男子","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"末世男子","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":125219,"name":"楽器店の店員","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/c6/bd/125219_crt_HB7Lz.jpg","actor_ids":[35173],"name_cn":"乐器店店员","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"乐器店店员","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":125220,"name":"楽器店の店長","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/a5/a8/125220_crt_z35Vd.jpg?r=1675522955","actor_ids":[27194],"name_cn":"乐器店店长","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"乐器店店长","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":125224,"name":"喜多の友人","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/63/ef/125224_crt_lLKlL.jpg","actor_ids":[5494,38883],"name_cn":"喜多的朋友","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"喜多的朋友","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":164132,"name":"STARRY","relation":"闲角","image_url":"https://lain.bgm.tv/pic/crt/l/b1/55/164132_crt_o3wqV.jpg","actor_ids":[],"name_cn":"繁星","summary":"STARRY是《孤独摇滚！》及其衍生作品中登场的一家架空的Livehouse。 \r\n\r\n为了支持妹妹伊地知虹夏，伊地知星歌离开了原先的乐队，开办了STARRY。\r\n\r\n据星歌称，STARRY这个名字寄托着“通过如繁星一般的乐队们的精彩演出，让这里成为一个能够将光芒照射到已逝母亲身边的闪耀地方”的愿望。\r\n\r\nSTARRY每天于东京时间下午5时开始售票。虽然店面小，但平日里生意却很好。 \r\n\r\n店内环境\r\n\r\nSTARRY位于地下，楼上则是伊地知一家的住所。店内环境较为阴暗、气氛沉闷，不过舞台灯光效果不错。\r\n\r\n一下楼梯可以看到一个吧台，在这里顾客可以用长得像吉他拨片的饮料券兑换饮料。每位顾客被要求强制消费一杯饮料（每杯500日元，不含在演出门票内），这是因为STARRY是以饮食店的形式获得营业许可证的。\r\n\r\n舞台使用的贝斯音响型号为Ampeg SVT Classic和Ampeg SVT 810E，吉他音响为Marshall JCM900 4100和Marshall 1960AV 4x12。 \r\n\r\n录音室\r\n\r\n店内设有录音室，结束乐队通常都在这里练习。\r\n\r\n录音室使用的贝斯音响为Ampeg SVT Classic和Ampeg SVT 610，吉他音响为Marshall JCM900 4100，Marshall 1960AV 4x12和Roland JC-120 Jazz Chorus。 \r\n\r\n店员\r\nSTARRY现有常驻员工2人，此外结束乐队四人也在此做兼职。 \r\n\r\n原型\r\nSTARRY的现实原型是一座叫做“下北沢SHELTER”的Livehouse。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"繁星","__dataclass__":"KeyValue"},{"key":"引用来源","value":"https://zh.moegirl.org.cn/STARRY","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":226884,"name":"ナレーション","relation":"旁白","image_url":"https://lain.bgm.tv/pic/crt/l/fc/10/226884_crt_OFHqr.jpg","actor_ids":[25841],"name_cn":"旁白 (孤独摇滚！)","summary":"","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"旁白 (孤独摇滚！)","__dataclass__":"KeyValue"}],"__dataclass__":"Character"}],"relations":[{"id":427293,"name":"「ぼっち・ざ・ろっく！」TVアニメ公式ガイドブック -COMPLEX-","name_cn":"","relation":"画集","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/93/11/427293_9YilL.jpg","__dataclass__":"Relation"},{"id":718501,"name":"結束バンド ASIA TOUR 2027 “To Asia.”","name_cn":"","relation":"衍生","type":6,"image_url":"https://lain.bgm.tv/pic/cover/l/bc/92/718501_qy300.jpg","__dataclass__":"Relation"},{"id":718086,"name":"映画ぼっち・ざ・ろっく！星のあしあと","name_cn":"电影 孤独摇滚！星之足迹","relation":"前传","type":2,"image_url":"https://lain.bgm.tv/pic/cover/l/d6/81/718086_3MYt2.jpg","__dataclass__":"Relation"},{"id":546940,"name":"LIVE STAGE「ぼっち・ざ・ろっく！」at KT Zepp Yokohama/Zepp Namba(OSAKA)","name_cn":"","relation":"三次元","type":6,"image_url":"https://lain.bgm.tv/pic/cover/l/b4/d6/546940_IZQFi.jpg","__dataclass__":"Relation"},{"id":546121,"name":"バンド・スコア TVアニメ「ぼっち・ざ・ろっく！」","name_cn":"","relation":"书籍","type":1,"image_url":"https://lain.bgm.tv/pic/cover/l/90/a5/546121_ou6Y4.jpg","__dataclass__":"Relation"},{"id":546116,"name":"ぼっち・ざ・ろっく！ 結束バンド Piano Score Vol.1","name_cn":"","relation":"书籍","type":1,"image_url":"https://lai