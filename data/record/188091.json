tion":"原声集","type":3,"image_url":"https://lain.bgm.tv/pic/cover/l/e5/da/216023_2q28O.jpg","__dataclass__":"Relation"},{"id":245001,"name":"牧羊人之心","name_cn":"牧羊人之心","relation":"游戏","type":4,"image_url":"https://lain.bgm.tv/pic/cover/l/b9/60/245001_t2m33.jpg","__dataclass__":"Relation"},{"id":522595,"name":"ガヴリールドロップアウト〜天使と悪魔のシェアハウス〜","name_cn":"","relation":"衍生","type":6,"image_url":"https://lain.bgm.tv/pic/cover/l/91/d9/522595_1894f.jpg","__dataclass__":"Relation"}],"episodes":[{"id":684544,"name":"もう戻れないと知ったあの日","name_cn":"深知无法回到从前","air_date":"2017-01-09","desc":"ガヴリールは品行方正でとっても優秀な天使。\r\n天使学校を首席で卒業した彼女は、人間の事を学び、さらに立派な天使になるために人間界にやってきました。 毎日、公園の掃除を行ったり子供たちの遊び相手になったり、善い行いをしながら人間の学校に通っています。\r\nある日、宿題を終えてひと息ついていると、パソコンの中から助けを呼ぶ声が聞こえてきました。\r\nそれは人間界の遊戯、ネットゲーム。\r\n運命の出会いを果たしてしまったガヴリールは・・・。\r\n\r\n脚本：あおしまたかし／絵コンテ：太田雅彦／演出：守田芸成／作画監督：中野裕紀","duration_seconds":1420,"ep":1,"sort":1,"type":0,"__dataclass__":"Episode"},{"id":684545,"name":"天使と悪魔と委員長","name_cn":"天使与恶魔与委员长","air_date":"2017-01-16","desc":"脚本：子安秀明     分镜：三原武宪    演出：野木森达哉","duration_seconds":1420,"ep":2,"sort":2,"type":0,"__dataclass__":"Episode"},{"id":684546,"name":"友と勤労と虫刺されの夏の日","name_cn":"朋友、劳动与被蚊虫叮咬的夏日","air_date":"2017-01-23","desc":"脚本：杉原研二     分镜：誌村宏明      演出：堂川セツム","duration_seconds":1420,"ep":3,"sort":3,"type":0,"__dataclass__":"Episode"},{"id":684547,"name":"いざ夏休み","name_cn":"暑假到来","air_date":"2017-01-30","desc":"脚本：鸿野贵光    分镜/演出：矢花馨","duration_seconds":1440,"ep":4,"sort":4,"type":0,"__dataclass__":"Episode"},{"id":684548,"name":"その幻想を壊されまくった天使","name_cn":"将幻想破坏殆尽的天使","air_date":"2017-02-06","desc":"脚本：青岛崇     分镜/演出：上坪亮树","duration_seconds":1420,"ep":5,"sort":5,"type":0,"__dataclass__":"Episode"},{"id":684549,"name":"サターニャの逆襲","name_cn":"撒塔妮亚的逆袭","air_date":"2017-02-13","desc":"脚本：子安秀明    分镜：三原武宪     演出：えんどうてつや","duration_seconds":1420,"ep":6,"sort":6,"type":0,"__dataclass__":"Episode"},{"id":684550,"name":"ヴィーネの悪魔的な日々","name_cn":"薇奈恶魔式的一天","air_date":"2017-02-20","desc":"脚本：杉原研二     分镜/演出：原口浩","duration_seconds":1420,"ep":7,"sort":7,"type":0,"__dataclass__":"Episode"},{"id":684551,"name":"秋の学校生活","name_cn":"秋季的学校生活","air_date":"2017-02-27","desc":"脚本：鸿野贵光     分镜/演出：荒井省吾","duration_seconds":1420,"ep":8,"sort":8,"type":0,"__dataclass__":"Episode"},{"id":684552,"name":"聖夜と晦日になんか来た","name_cn":"圣诞与新年到来","air_date":"2017-03-06","desc":"脚本：子安秀明     分镜：角松俱乐部、儿谷直树      演出：","duration_seconds":1420,"ep":9,"sort":9,"type":0,"__dataclass__":"Episode"},{"id":684553,"name":"天使と悪魔故郷に帰る","name_cn":"天使与恶魔回归故乡","air_date":"2017-03-13","desc":"脚本：杉原研二     分镜/演出：矢花馨","duration_seconds":1420,"ep":10,"sort":10,"type":0,"__dataclass__":"Episode"},{"id":684554,"name":"楽しい日々はいつまでも……","name_cn":"快乐的日子永不完结……","air_date":"2017-03-20","desc":"脚本：鸿野贵光    分镜：いわたかずや　演出：えんどうてつや","duration_seconds":1420,"ep":11,"sort":11,"type":0,"__dataclass__":"Episode"},{"id":684555,"name":"ガヴリールドロップアウト！","name_cn":"珈百璃的堕落！","air_date":"2017-03-27","desc":"脚本：青岛崇     分镜：太田雅彦      演出：荒井省吾","duration_seconds":1420,"ep":12,"sort":12,"type":0,"__dataclass__":"Episode"},{"id":698132,"name":"湯煙旅情編～天使の清らかな肌に迫る悪魔の罠～","name_cn":"泉烟旅情篇～逼近天使清纯肌肤的恶魔之陷阱～","air_date":"2017-03-24","desc":"脚本：あおしまたかし／絵コンテ：三原武憲／演出：佐々木達也／\r\n作画監督：海保仁美、菊永千里、菊池政芳、藤田真弓、金璐浩、金容植／作画監督補佐：池添優子、菅原美智代\r\n\r\nヴィーネが商店街の福引で当てた宿泊券を使って、温泉旅行に行く事になったガヴリールたち4人。そんな中、サターニャは温泉で「あるアイテム」を使ってガヴリールをやり込めようと企みます。しかしテンションの高いヴィーネとは対照的に旅館に到着してもガヴリールはいつも通りのマイペース。サターニャは、ぐーたらして動こうとしないガヴリールを様々な方法で温泉に連れて行こうとするのですが・・・。","duration_seconds":863,"ep":0,"sort":1,"type":1,"__dataclass__":"Episode"},{"id":698133,"name":"天使の贈り物","name_cn":"天使的礼物","air_date":"2017-05-24","desc":"","duration_seconds":1010,"ep":0,"sort":2,"type":1,"__dataclass__":"Episode"}],"__dataclass__":"ANiMeData"},"user_status":{"watch_status":2,"watched_eps":12,"last_update":"2026-11-06T18:54:14+08:00","comment":null,"tags":["ロリがある","日常"],"__dataclass__":"UserStatus"},"__dataclass__":"ANiMeRecord"}