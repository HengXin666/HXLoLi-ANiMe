ter"},{"id":137343,"name":"シャルフ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/6e/14/137343_crt_81s8L.jpg?r=1708109940","actor_ids":[28519],"name_cn":"夏鲁夫","summary":"三級魔法使いの男性で、一次試験でヴィアベルやエーレと同じパーティーになる。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"夏鲁夫","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"},{"key":"引用来源","value":"wiki","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137344,"name":"エーレ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/2d/b2/137344_crt_SVf0b.jpg?r=1705175972","actor_ids":[4949],"name_cn":"艾露","summary":"二級魔法使いの女の子で、一次試験でヴィアベルやシャルフと同じパーティーになる。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"艾露","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"},{"key":"引用来源","value":"wiki","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137346,"name":"ゼーリエ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/96/24/137346_crt_v0fW9.jpg?r=1708109882","actor_ids":[4769],"name_cn":"赛丽艾","summary":"遥か古より生き続けるエルフの女性。神話の時代の大魔法使いであり、フランメの師匠でもある。約1000年前、フランメが連れてきたフリーレンと顔合わせをした。人類の歴史上のほぼ全ての魔法を習得した生ける魔導書と言われ、全知全能の女神様に最も近い魔法使いと評される。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"赛丽艾","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"},{"key":"引用来源","value":"wiki","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137347,"name":"エーデル","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/39/95/137347_crt_L5mTT.jpg?r=1708109763","actor_ids":[9560],"name_cn":"艾迪露","summary":"二級魔法使いの女性で、一次試験でブライやドゥンストと同じパーティーになる。戦闘能力は皆無だが、非常に優れた精神操作魔法のスペシャリスト。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"艾迪露","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"},{"key":"引用来源","value":"wiki","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137348,"name":"メトーデ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/7b/4e/137348_crt_W1jKK.jpg?r=1708110046","actor_ids":[13164],"name_cn":"梅托帝","summary":"一次試験でレンゲやトーンと同じパーティになった女性の魔法使い。二次試験ではデンケン達と共闘する。拘束魔法や精神操作魔法を使用できるが、フリーレンには通じなかった。魔力探知が得意で、魔法使いとしては珍しく回復魔法も使える。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"梅托帝","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137356,"name":"レルネン","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/1e/e2/137356_crt_4XPlq.jpg?r=1729700070","actor_ids":[4826],"name_cn":"勒宁","summary":"老齢の一級魔法使いでゼーリエの側近。従来は第三次試験の担当を任されている。大魔法使いゼーリエの弟子であり、半世紀前に第1号の一級魔法使いになった。また、二次試験で活躍した脱出用ゴーレムの開発者でもある。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"勒宁","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"},{"key":"引用来源","value":"wiki","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137366,"name":"全知のシュラハト","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/a0/b3/137366_crt_skcuc.jpg","actor_ids":[],"name_cn":"全知的修拉哈特","summary":"かつての魔王の腹心で、千年後の未来まで見通す魔法を操る。全七崩賢と共に南の勇者を迎え撃ったが、七崩賢のうち三人は討ち取られて自身も相打ちで倒されたとされる。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"全知的修拉哈特","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137368,"name":"南の勇者","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/27/15/137368_crt_3fuwW.jpg?r=1769184885","actor_ids":[1582],"name_cn":"南之勇者","summary":"人類最強と称された、伝説の勇者。未来を予知できる能力を持ち、“七崩賢”の内、三人を討ち取るも、シュラハトと相打ちとなったと伝えられている。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"南之勇者","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137370,"name":"ダッハ伯爵","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/10/71/137370_crt_gHkkJ.jpg?r=1694050437","actor_ids":[7546],"name_cn":"达哈伯爵","summary":"代々、家宝の宝剣ぬすまれがち。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"达哈伯爵","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137371,"name":"ファス","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/d7/9f/137371_crt_2P0Ei.jpg","actor_ids":[4657],"name_cn":"法斯","summary":"ビーア地方の街に住んでいるドワーフ。過去に勇者一行とも出会ったことがあり、フリーレンと80年ぶりに再会する。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"法斯","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137373,"name":"ミリアルデ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/3b/01/137373_crt_SPdh8.jpg","actor_ids":[3827],"name_cn":"米莉亚尔黛","summary":"エルフの女性で、かつてのフリーレンの知り合い。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"米莉亚尔黛","__dataclass__":"KeyValue"},{"key":"性别","value":"女","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137375,"name":"ノルム卿","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/1d/26/137375_crt_3dx8j.jpg","actor_ids":[20142],"name_cn":"诺姆会长","summary":"北部高原を牛耳るノルム商会の会長。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"诺姆会长","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":137380,"name":"神技のレヴォルテ","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/0f/57/137380_crt_z3Tl6.jpg","actor_ids":[4101],"name_cn":"神技的雷沃戴","summary":"四本の腕と大蛇のような下半身をもつ魔族の将軍。複数の剣を巧みに操る。","birth_year":null,"birth_month":null,"birth_day":null,"tags":[{"key":"简体中文名","value":"神技的雷沃戴","__dataclass__":"KeyValue"},{"key":"性别","value":"男","__dataclass__":"KeyValue"}],"__dataclass__":"Character"},{"id":138004,"name":"ゲーエン","relation":"配角","image_url":"https://lain.bgm.tv/pic/crt/l/9